# PRODUCTION Supabase credentials — used ONLY by admin scripts:
#   scripts/backup-data.mjs, scripts/apply-sql.ts, scripts/pull-recipes.mjs (read-only).
# Next.js never loads this file. Do NOT add SUPABASE_SECRET_KEY / SUPABASE_ACCESS_TOKEN to Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ACCESS_TOKEN=
