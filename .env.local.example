# Local development — points at the local Supabase stack (`corepack pnpm db:start`).
# Production credentials go in .env.prod.local (see .env.prod.local.example).

# Clerk — https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local Supabase — fixed defaults, confirm with `corepack pnpm db:status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SECRET_KEY=   # "Secret" key from `corepack pnpm db:status`
# Skip Clerk locally and use SUPABASE_SECRET_KEY. Never set on Vercel.
DEV_AUTH_BYPASS=1

# Private-app allowlist: comma-separated emails permitted to use the app
ALLOWED_EMAILS=

OPENROUTER_API_KEY=
